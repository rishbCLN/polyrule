{
  "base": {
    "description": "Universal engineering baseline for any project.",
    "rules": [
      "core/clean-code",
      "core/security-baseline",
      "core/git-commits",
      "core/testing",
      "practices/error-handling"
    ]
  },
  "nextjs-fullstack": {
    "description": "Next.js App Router + TypeScript + Tailwind full-stack app.",
    "extends": "base",
    "rules": [
      "languages/typescript",
      "frameworks/react",
      "frameworks/nextjs",
      "frameworks/tailwind",
      "practices/accessibility",
      "practices/performance"
    ]
  },
  "react-frontend": {
    "description": "React + TypeScript + Tailwind frontend.",
    "extends": "base",
