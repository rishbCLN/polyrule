      "languages/typescript",
      "frameworks/react",
      "frameworks/tailwind",
      "practices/accessibility",
      "practices/performance"
    ]
  },
  "vue-frontend": {
    "description": "Vue 3 + TypeScript + Tailwind frontend.",
